# The origin the browser will actually report. Development defaults to
# http://localhost:3000; a deployment must set this to the public URL, scheme
# included and no trailing slash, or every ceremony fails origin_mismatch.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Optional. Without it a random secret is generated at boot, which is fine for
# a demo whose sessions are disposable but means a restart signs everyone out.
DEMO_SESSION_SECRET=
