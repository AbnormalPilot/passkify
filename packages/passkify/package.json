    "./cloudflare": {
      "import": {
        "types": "./dist/esm/adapters/cloudflare.d.ts",
        "default": "./dist/esm/adapters/cloudflare.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/cloudflare.d.cts",
        "default": "./dist/cjs/adapters/cloudflare.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "generated",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:dist": "npm run build && vitest run --mode dist",
    "generate": "node scripts/generate.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "pg": "*",
    "postgres": "*",
    "ioredis": "*",
    "redis": "*",
    "mongodb": "*",
    "@prisma/client": "*",
    "better-sqlite3": "*",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "bin": {
    "passkify": "./bin/passkify.mjs"
  }
}
