      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/esm/adapters/fastify.d.ts",
        "default": "./dist/esm/adapters/fastify.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/fastify.d.cts",
        "default": "./dist/cjs/adapters/fastify.js"
      }
    },
    "./sveltekit": {
      "import": {
        "types": "./dist/esm/adapters/sveltekit.d.ts",
        "default": "./dist/esm/adapters/sveltekit.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/sveltekit.d.cts",
        "default": "./dist/cjs/adapters/sveltekit.js"
      }
    },
    "./remix": {
      "import": {
        "types": "./dist/esm/adapters/remix.d.ts",
        "default": "./dist/esm/adapters/remix.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/remix.d.cts",
