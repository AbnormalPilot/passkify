      }
    },
    "./stores/schema": {
      "import": {
        "types": "./dist/esm/stores/schema.d.ts",
        "default": "./dist/esm/stores/schema.js"
      },
      "require": {
        "types": "./dist/cjs/stores/schema.d.cts",
        "default": "./dist/cjs/stores/schema.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/esm/adapters/next.d.ts",
        "default": "./dist/esm/adapters/next.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/next.d.cts",
        "default": "./dist/cjs/adapters/next.js"
      }
    },
