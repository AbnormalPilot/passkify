    },
    "./stores/redis": {
      "import": {
        "types": "./dist/esm/stores/redis.d.ts",
        "default": "./dist/esm/stores/redis.js"
      },
      "require": {
        "types": "./dist/cjs/stores/redis.d.cts",
        "default": "./dist/cjs/stores/redis.js"
      }
    },
    "./stores/mongodb": {
      "import": {
        "types": "./dist/esm/stores/mongodb.d.ts",
