{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/node_modules",
      "!**/lib/generated",
      "!**/package-lock.json",
      "!**/*.mdx",
      "!**/*.css",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": { "formatter": { "enabled": false } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } },
        "noConfusingVoidType": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "error",
        "useNodejsImportProtocol": "error"
      },
      "complexity": { "noExcessiveCognitiveComplexity": "off" },
      "performance": { "noDelete": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "overrides": [
    {
      "includes": ["apps/docs/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off", "noAssignInExpressions": "off" },
          "performance": { "noImgElement": "off" }
        }
      }
    },
    {
      "includes": ["packages/passkify/test/**", "**/scripts/**", "packages/passkify/src/cli/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off", "noExplicitAny": "off" } } }
    }
  ]
}
